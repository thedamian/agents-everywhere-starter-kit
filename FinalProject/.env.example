# Default offline demo: no external API credentials required.
HOST=127.0.0.1
PORT=3101
BRIEF_PROVIDER=mock
PROFILE_PROVIDER=mock
MEDIA_PROVIDER=mock
JOB_PROVIDER=local
FOLLOWUP_PROVIDER=disabled
ALLOW_DEMO_FALLBACKS=false
MOCK_ONLY=false

# If blank, startup writes a generated pairing token to .runtime/device-token.
DEMO_DEVICE_TOKEN=
# Exact browser origins. Default is the server's loopback origin.
ALLOWED_ORIGINS=
# Non-loopback binding requires an explicit token, trusted hosts and origins.
ALLOWED_HOSTS=

# Required only for explicitly selected live providers. Keep these server-side.
OPENAI_API_KEY=
MODEL=
EXA_API_KEY=
MEDIA_SERVICE_URL=
MEDIA_SERVICE_TOKEN=

# Authoritative showroom: disabled, explicit offline fixture, or full studio.
# The kiosk launcher selects fixture by default; live capabilities require flags.
SHOWROOM_MODE=disabled
MOVIE_STUDIO_URL=http://127.0.0.1:3200
MOVIE_API_TOKEN=
VOICE_ENABLED=false
VOICE_MODEL=gpt-live-1
REASONING_MODEL=gpt-5.6-luna
REGULAR_MODEL=gpt-5.6-luna

# Local Windows operator bootstrap only; never send this master token to iPad.
# Enabling the bridge is not permission to pair BLE or enable physical movement.
SHOWROOM_OPERATOR_TOKEN=
SHOWROOM_BRIDGE_ENABLED=false
SHOWROOM_BRIDGE_ORIGINS=http://127.0.0.1:3200

# Google Calendar is a separate opt-in. OAuth setup runs on the operator host.
CALENDAR_PROVIDER=disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3101/oauth/google/callback
GOOGLE_CALENDAR_ID=primary
SCHEDULING_TIME_ZONE=America/New_York
SCHEDULING_DURATION_MINUTES=60
SCHEDULING_STAFF_EMAILS=
SCHEDULING_LOCATION=

# Operational safety limits, separate from the advisory two-minute UX target.
# Keep the session alive while the robot talks and media is generated.
SESSION_TTL_MS=28800000
JOB_TIMEOUT_MS=900000
MAX_SESSIONS=32
MAX_QUEUED_JOBS=4
MAX_UPLOAD_BYTES=5242880
MAX_MEDIA_BYTES=20971520

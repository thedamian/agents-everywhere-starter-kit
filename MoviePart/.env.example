# MoviePart studio, worker, operator CLI, and separate Dwight media service.
# Copy only when creating a new .env; never overwrite existing credentials.
# Fill keys/tokens privately. No provider requests are made just by starting up.

# OpenAI reference analysis, direction, storyboard images, and continuity review.
# Explicit example model choices: confirm access and billing for your account.
# If vision/director models are unset, those services currently use gpt-4.1.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_DIRECTOR_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Google Veo is required for the studio's default generated-video workflow.
# Submission still requires an explicit user action and approved references.
GEMINI_API_KEY=
# GOOGLE_API_KEY= is also supported; GEMINI_API_KEY takes precedence.
VEO_MODEL=veo-3.1-generate-preview
# Verify key/model visibility without submitting a paid video: npm run veo:check
# Veo also requires paid-tier billing and available project quota in Google AI Studio.

# Review controls. Two minutes is a soft target, not a cutoff.
# Policy: practical or strict. Attempts: 1-20 per shot/explicit attempt.
# Concurrency: 1-4 shot tasks. Increasing these may increase API spend.
CONTINUITY_POLICY=practical
STORYBOARD_MAX_ATTEMPTS=8
STORYBOARD_CONCURRENCY=2

# Optional Sora alternative, used only when explicitly selected instead of Veo.
# Car-only video: real-person likeness and human-face references are unsupported.
# Temporary integration: OpenAI schedules Sora API shutdown for September 24, 2026.
OPENAI_VIDEO_MODEL=sora-2-pro

# Private state shared by the studio and worker. Keep outside public/ and Git.
# Keep this nonempty so the separate media service uses the same private root.
MOVIE_DATA_DIR=.movie-data

# Optional machine/CLI access to the creator studio; not a kiosk/device token.
MOVIE_API_TOKEN=
# CLI destination only; does not change the studio's port or bind address.
MOVIE_STUDIO_URL=http://127.0.0.1:3200

# Leave overrides unset to use the bundled FFmpeg/ffprobe binaries.
# Uncomment only when supplying valid absolute executable paths.
# FFMPEG_PATH=C:\Tools\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\Tools\ffmpeg\bin\ffprobe.exe

# Native video audio is preserved automatically; a music bed is not required.
# Optional licensed local music is mixed underneath it, never fetched by URL.
# MOVIE_MUSIC_PATH=C:\LicensedMusic\bed.wav

# Separate Dwight -> Tiya media service; never give this token to the kiosk.
MEDIA_SERVICE_TOKEN=
MEDIA_SERVICE_PORT=3201
# Ten-minute operational timeout for this media service only, not the studio.
MEDIA_SERVICE_JOB_TIMEOUT_MS=600000

# Default studio cut: 3s opening zoom + 8s real video + 4s closing zoom.
# Supported movie lengths: 13, 15, 18, 23, 28 seconds (15 by default).
# Longer cuts generate 2-3 video clips and may cost more; they do not loop video.
# Layout and duration are request/UI settings (render_layout and
# movie_duration_seconds), not environment variables.
# Same-origin kiosk gateway; these are private server settings, not NEXT_PUBLIC.
# Point the trusted HTTPS reverse proxy at the loopback MoviePart web port.
SHOWROOM_API_UPSTREAM=http://127.0.0.1:3101
SHOWROOM_PUBLIC_ORIGIN=http://127.0.0.1:3200
# Session capability comes from one-time pairing and stays in browser memory.
# Do not expose the studio APIs, operator routes or service ports to the iPad.
# After editing .env, wait for active jobs to finish, then restart the web app
# and worker (and media service if running). Browser refresh alone is not enough.
